; Engine configuration file.
config_version=5
[application]
config/name="Last Impact R0757"
run/main_scene="res://lobby.tscn"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.07, 0.11, 0.15, 1)
boot_splash/show_image=false
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
scaling_3d/mode=0
scaling_3d/scale=1.0
scaling_3d/scale.android=1.0
environment/defaults/default_clear_color=Color(0.07, 0.11, 0.15, 1)
[input_devices]
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false
